# Parikrama Sidecar Configuration
# Repository root directory (absolute path)
REPO_ROOT=C:\path\to\your\project

# Sidecar API Server
SIDECAR_PORT=3001
SIDECAR_HOST=localhost
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Cache TTL in seconds (1 hour default)
CACHE_TTL=3600

# MCP settings (used by the MCP stdio process)
MCP_SIDECAR_HOST=localhost
MCP_SIDECAR_PORT=3001
