# ─────────────────────────────────────────────────────────────────
# Advanced Quality Tool — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Project ────────────────────────────────────────────────────────
# Absolute path to the project you want to analyse (mounted as /workspace)
AQT_PROJECT_PATH=./

# ── UI Server ─────────────────────────────────────────────────────
AQT_UI_PORT=3000

# ── AI Providers (optional) ────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ── GitHub / GitLab Integration ────────────────────────────────────
GITHUB_TOKEN=
GITLAB_TOKEN=
AQT_PR_PROVIDER=github

# ── Notifications ─────────────────────────────────────────────────
# Slack incoming webhook URL
AQT_SLACK_WEBHOOK_URL=

# SMTP email settings
AQT_SMTP_HOST=smtp.example.com
AQT_SMTP_PORT=587
AQT_SMTP_USER=
AQT_SMTP_PASS=
AQT_EMAIL_FROM=aqt@example.com
AQT_EMAIL_TO=team@example.com

# ── Rule Pack Registry ─────────────────────────────────────────────
AQT_REGISTRY_TOKEN=

# ── Misc ───────────────────────────────────────────────────────────
NODE_ENV=production
