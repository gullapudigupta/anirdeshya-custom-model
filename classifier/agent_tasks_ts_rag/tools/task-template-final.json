  "taskCreationGuide": {
    "requiredFields": [
      {
        "field": "id",
        "type": "string",
        "format": "P{phase}-T{number}",
        "example": "P9-T041",
        "description": "Unique task identifier"
      },
      {
        "field": "name",
        "type": "string",
        "example": "New Task Name",
        "description": "Human-readable task name"
      },
      {
        "field": "status",
        "type": "string",
        "enum": [
          "PENDING",
          "IN_PROGRESS",
          "COMPLETED",
          "BLOCKED",
          "CANCELLED"
        ],
        "default": "PENDING",
        "description": "Current task status"
      },
      {
        "field": "priority",
        "type": "string",
        "enum": [
          "CRITICAL",
          "HIGH",
          "MEDIUM",
          "LOW"
        ],
        "default": "MEDIUM",
        "description": "Task priority level"
      },
      {
        "field": "estimatedHours",
        "type": "number",
        "minimum": 1,
        "example": 16,
        "description": "Estimated hours to complete"
      },
      {
        "field": "value",
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "example": 85,
        "description": "Business value score (0-100)"
      },
      {
        "field": "recommendedModel",
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "maxItems": 3,
        "example": [
          "deepseek-v4-flash",
          "gpt-4o-mini",
          "claude-haiku-4"
        ],
        "description": "Array of recommended models in priority order (lowest cost first)"
      },
      {
        "field": "modelRationale",
        "type": "string",
        "example": "Explain why these models and when to escalate",
        "description": "Explanation of model selection and escalation triggers"
      },
      {
        "field": "dependencies",
        "type": "array",
        "items": {
          "type": "string"
        },
        "example": [
          "P9-T001",
          "P9-T002"
        ],
        "description": "Array of task IDs that must be completed first"
      },
      {
        "field": "deliverables",
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "example": [
          "Deliverable 1",
          "Deliverable 2"
        ],
        "description": "List of expected deliverables"
      },
      {
        "field": "tags",
        "type": "array",
        "items": {
          "type": "string"
        },
        "example": [
          "documentation",
          "inventory"
        ],
        "description": "Categorization tags"
      },
      {
        "field": "modelAssignment",
        "type": "object",
        "description": "First choice + equal-grade alternatives from the model catalog"
      },
      {
        "field": "executionPlan",
        "type": "object",
        "description": "order, batch, band, scriptable, estimatedCostUsd"
      },
      {
        "field": "executionResult",
        "type": "object|null",
        "description": "null until COMPLETED, then model/confidence/notes"
      },
      {
        "field": "jevRecommendation",
        "type": "object|null",
        "description": "null until the JEV system is queried"
      }
    ],
    "optionalFields": [
      {
        "field": "pipelineId",
        "type": "string",
        "example": "pipeline-ledger",
        "description": "Identifier for pipeline-based tasks"
      },
      {
        "field": "pipelineStages",
        "type": "array",
        "items": {
          "type": "string"
        },
        "example": [
          "register",
          "start",
          "complete"
        ],
        "description": "Stages in pipeline execution"
      },
      {
        "field": "executionRecord",
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "store": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "pipeline": {
            "type": "string"
          }
        },
        "description": "Execution record configuration"
      },
      {
        "field": "completedDate",
        "type": "string",
        "format": "date",
        "example": "2026-09-30",
        "description": "Date task was completed"
      },
      {
        "field": "artifacts",
        "type": "array",
        "items": {
          "type": "string"
        },
        "example": [
          "src/core/services.js"
        ],
        "description": "Files or artifacts produced by this task"
      },
      {
        "field": "blocker",
        "type": "string",
        "description": "Description of what is blocking this task"
      },
      {
        "field": "notes",
        "type": "string",
        "description": "Additional notes or context"
      },
      {
        "field": "automation",
        "type": "object",
        "description": "Script-only execution spec (see newProperties.automation)"
      },
      {
        "field": "userClarifications",
        "type": "array",
        "description": "Questions and answers captured through `node tools/cli.js clarify`; statuses are confirmed, recorded_decision or awaiting_user_input"
      }
    ],
    "recommendedModelRule": "1-3 catalog ids, first choice first; remaining entries are equal-grade alternatives (not escalations)."
  },
